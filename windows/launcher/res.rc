#include <winver.h>
1 ICON "../assets/sciplayer.ico"
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "SciPlayer"
      VALUE "FileDescription", "SciPlayer - video player for scientific recordings"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "SciPlayer"
      VALUE "OriginalFilename", "SciPlayer.exe"
      VALUE "ProductName", "SciPlayer"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
